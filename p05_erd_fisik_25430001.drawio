t x="2330" y="517"/></Array></mxGeometry></mxCell><mxCell id="f245" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f244"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f246" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f244"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f247" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;endSize=12;startSize=12;strokeWidth=1.5;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f198" target="f173"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3090" y="825"/><mxPoint x="3090" y="517"/></Array></mxGeometry></mxCell><mxCell id="f248" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f247"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f249" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="f247"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f250" value="&lt;b&gt;ERD Fisik Nexus Pustaka AR&lt;/b&gt; &amp;mdash; basis data perpus_001 (MariaDB 10.4) &amp;mdash; sesuai p05_ddl_25430001.sql &amp;mdash; Aditya Rizaldiansyah, NIM 25430001" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1600" height="40" as="geometry"/></mxCell><mxCell id="f251" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = kunci primer (digarisbawahi) &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; = kunci tamu, tabel tujuan ditulis dengan tanda &amp;rarr; &amp;nbsp; &lt;b&gt;UQ&lt;/b&gt; = UNIQUE &amp;nbsp; &lt;b&gt;UQ1&lt;/b&gt; = UNIQUE gabungan uq_detail_peminjaman_eksemplar (id_peminjaman, id_eksemplar) &amp;nbsp; &lt;b&gt;CK&lt;/b&gt; = constraint CHECK (baris abu-abu) &amp;nbsp; &lt;b&gt;AI&lt;/b&gt; = AUTO_INCREMENT &amp;nbsp; &lt;b style=&quot;color:#b85450&quot;&gt;PDP&lt;/b&gt; = data pribadi (UU PDP)&lt;br&gt;Semua kunci tamu memakai aksi bawaan ON DELETE RESTRICT (tidak ada CASCADE). Nama FK: fk_&amp;lt;tabel&amp;gt;_&amp;lt;tujuan&amp;gt;; nama UNIQUE: uq_&amp;lt;tabel&amp;gt;_...; nama CHECK: ck_&amp;lt;tabel&amp;gt;_...&lt;br&gt;Nilai turunan hari_terlambat_denda, jumlah_denda, jumlah_buku, dan total_denda &lt;b&gt;tidak digambar&lt;/b&gt; karena diputuskan dihitung (p04).&lt;br&gt;Tidak dapat dijaga CHECK, ditandai untuk Modul 14: AB-05 (maks. P + 2 = 4 buku per peminjaman), AB-08, AB-04, AB-12.&lt;br&gt;Kardinalitas: 1 = tepat satu, 0..1 = nol atau satu, 0..N = nol atau banyak, 1..N = satu atau banyak." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="2180" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>