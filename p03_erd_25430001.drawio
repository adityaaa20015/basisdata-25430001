  <mxCell id="p4note" value="&lt;b&gt;Perubahan Pertemuan 4 (normalisasi)&lt;/b&gt;&lt;br&gt;1. tanggal_jatuh_tempo dipindah dari detail_peminjaman ke peminjaman menjadi tanggal_jatuh_tempo_peminjaman, karena AB-10: setiap peminjaman memiliki satu tanggal jatuh tempo (FD1).&lt;br&gt;2. AB-03 direvisi: nim_anggota unik untuk setiap anggota (tetap AK).&lt;br&gt;Rincian: p04_normalisasi_25430001.md" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f4ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="256" y="690" width="720" height="120" as="geometry" /></mxCell></root>
