        <mxCell id="k178" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" value="&lt;b&gt;PK&lt;/b&gt; = kunci primer (digarisbawahi)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; = kunci tamu, merujuk PK dengan nama sama&lt;br&gt;&lt;b&gt;PK,FK&lt;/b&gt; = bagian kunci primer komposit sekaligus kunci tamu&lt;br&gt;&lt;b&gt;AK&lt;/b&gt; = kunci alternatif (unik, bukan PK)&lt;br&gt;&lt;br&gt;Simbol dekat kotak entitas = maksimum; simbol yang lebih jauh = minimum. Garis ditarik dari PK ke FK; kata kerja di tengah garis = nama relasi. Atribut turunan (subtotal, total, diskon, kembalian) tidak digambar. Tipe data dan constraint ditetapkan di Modul 5." vertex="1">
          <mxGeometry height="165" width="560" x="460" y="860" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
